# ===========================================================================
# Opintodashboard .gitignore
# Periaate: repoon menee vain koodi ja yleiset esimerkkitiedostot. Kaikki
# omat kirjautumiset, tokenit ja oma kurssidata jäävät vain omalle koneelle.
# ===========================================================================

# --- Salaisuudet ja kirjautumistiedot (EI IKINÄ repoon) ---------------------
# Asetukset-välilehti tallentaa nämä .env-tiedostoon.
.env
.env.*
!.env.example
# Google OAuth: Cloud Consolesta ladattu client-tiedosto ja kirjautumistoken
credentials.json
credentials*.json
client_secret*.json
token.json
token*.json
# Google-synkan tila (sisältää omien kalenteritapahtumien tunnisteet)
sync_state.json

# --- Oma kurssidata (jokaisella omansa) -------------------------------------
# Luo oma kopioimalla data.example.json -> data.json (npm run setup tekee
# tämän automaattisesti). data.js generoidaan aina data.json:sta.
data.json
data.js
data.json.bak
*.bak
# Moodle-skannausten välimuistit (omat tehtävänannot ja kuvaukset)
deadline_scan.json
sync_report.json

# --- Debug-dumpit ------------------------------------------------------------
# Tallennettuja Moodle-sivuja: sisältävät nimen, kurssit ja istuntotietoja.
debug_*.html
debug_*.json

# --- Node.js -----------------------------------------------------------------
# Projektilla ei ole npm-riippuvuuksia, mutta varmuuden vuoksi:
node_modules/
package-lock.json
npm-debug.log*
*.log

# --- Käyttöjärjestelmät ja editorit -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
*.swp
*.swo
*~
