# ===========================================================================
# Opintodashboard .gitignore
# Periaate: repoon menee vain koodi ja yleiset esimerkkitiedostot. Kaikki
# omat kirjautumiset, tokenit ja oma kurssidata jäävät vain omalle koneelle.
# ===========================================================================

# --- Asetukset ja kirjautumistiedot (EI IKINÄ repoon) -----------------------
# Asetukset-välilehti tallentaa nämä .env-tiedostoon.
.env
.env.*
!.env.example

# --- Omat tiedot: data/-kansiossa vain esimerkki on gitissä ------------------
# data.json (kurssit), credentials.json ja token.json (Google-kirjautuminen),
# sync_state.json, sync_report.json, deadline_scan.json ...
data/*
!data/data.example.json

# Generoitu data/data.json:sta (npm run build)
public/data.js

# Vianetsinnän HTML-tallenteet: sisältävät nimen, kurssit ja istuntotietoja
debug/

# --- Varmuuden vuoksi myös vanhan rakenteen tiedostot juuressa ---------------
# (npm start / npm run setup siirtää nämä data/-kansioon)
/data.json
/data.js
credentials*.json
client_secret*.json
token*.json
sync_state.json
sync_report.json
deadline_scan.json
debug_*.html
*.bak

# --- Node.js -----------------------------------------------------------------
# Projektilla ei ole npm-riippuvuuksia, mutta varmuuden vuoksi:
node_modules/
package-lock.json
npm-debug.log*
*.log

# --- Käyttöjärjestelmät ja editorit -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
*.swp
*.swo
*~
