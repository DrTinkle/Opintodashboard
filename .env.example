# Kopioi tama tiedosto nimelle ".env" samaan kansioon ja tayta omat arvosi
# (npm run setup tekee taman automaattisesti). Helpoin tapa tayttaa arvot on
# dashboardin Asetukset-valilehti.
# .env-tiedostoa ei jaeta kenellekaan eika sita pida committaa mihinkaan
# (jos tama kansio joskus laitetaan gittiin, .gitignore jo estaa taman).

# Google-kirjautuminen (sync_to_google.js) -- OAuth-clientin tiedot Google
# Cloud Consolesta, ks. docs/google-kalenteri.md.
# Vaihtoehto data/credentials.json-tiedostolle, kumpi tahansa riittaa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Moodle-kirjautuminen -- TÄYTÄ JOKO ylläolevat kaksi (suositus, hoitaa
# kirjautumisen ja MoodleSession-evästeen uusimisen kokonaan automaattisesti)
# TAI pelkkä MOODLE_SESSION alla (jos et halua tallentaa salasanaasi tänne).
#
# MOODLE_USERNAME/MOODLE_PASSWORD: SAMK-tunnuksesi. scrape_course_content.js,
# find_moodle_ids.js ja refresh_moodle_session.js kirjautuvat näillä
# automaattisesti SAMK:in kirjautumisen (Shibboleth-SSO) kautta aina kun
# MoodleSession on vanhentunut, eikä evästettä tarvitse enää hakea käsin
# DevToolsista. HUOM: nämä tallennetaan selkokielisenä, suojaa tiedosto ja
# konetta normaalisti -- Haka-tunnus pääsee periaatteessa useampaan
# palveluun kuin pelkkä Moodle-eväste.
MOODLE_USERNAME=
MOODLE_PASSWORD=

# MOODLE_SESSION: DevToolsista haettu MoodleSession-evasteen arvo, vaihtoehto
# yllä oleville jos et halua tallentaa salasanaa. Jos MOODLE_USERNAME/
# MOODLE_PASSWORD on myös asetettu, tätä käytetään ensin ja uusitaan
# automaattisesti vain jos se on vanhentunut. --session-lippu voittaa aina
# kaiken jos sen antaa erikseen ajossa.
MOODLE_SESSION=

# MOODLE_USERID: oma numeerinen Moodle-käyttäjä-id:si. Tarvitaan uusien
# kurssien löytämiseen ("Hae Moodlesta" -nappi / sync_moodle.js) ja
# find_moodle_ids.js:lle. Löydät sen
# kalenterin ICS-vientilinkin "userid="-parametrista, tai omalta
# profiilisivultasi Moodlessa. Ei mitään oletusta - tämä on jokaiselle oma.
MOODLE_USERID=

# SAMK_GROUP: oma ryhmätunnuksesi (esim. AIC25SP). Käytetään kurssitietojen
# (op, päivämäärät, koodi, opettaja) hakuun SAMKin julkisesta opinto-oppaasta,
# jotta oikean ryhmän toteutus löytyy. Valinnainen, mutta suositeltu.
SAMK_GROUP=

# DeepSeek-API -- kaytetaan arvioimaan estimatedHours/estimatedPace jokaiselle
# AIDOSTI UUDELLE Moodle-skannauksessa loydetylle tehtavalle (sync_moodle.js
# ja update_from_moodle.js), ks. docs/INDEX.md, osio "DeepSeek-arviot".
# Hae oma avaimesi osoitteesta platform.deepseek.com.
# Jos tama jatetaan tyhjaksi, tehtavat lisataan silti normaalisti - vain
# ilman aika-arviota.
DEEPSEEK_API_KEY=
